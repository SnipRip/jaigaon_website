# Copy to .env.local. Never commit .env.local.

# Public address of this website (canonical URLs, sitemap, social previews).
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Where WhatsApp sign-ups are recorded: the dashboard backend.
# Server-only values. WEBSITE_API_KEY must equal the backend's WEBSITE_API_KEY.
DASHBOARD_API_URL=http://localhost:4000
WEBSITE_API_KEY=
